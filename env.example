# =============================================================================
# Variaveis de ambiente do projeto. Copie este arquivo para .env e preencha
# os valores reais. O arquivo .env NUNCA deve ser commitado.
# =============================================================================

# ---- Django ----------------------------------------------------------------
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=troque-isto-por-um-segredo-real

# 1 = modo desenvolvimento (DEBUG ligado). 0 = producao.
DJANGO_DEBUG=1

# Hosts permitidos, separados por virgula.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Em producao com HTTPS, defina os dominios completos:
# DJANGO_CSRF_TRUSTED_ORIGINS=https://seudominio.com


# ---- Servidor de batalha Java ----------------------------------------------
# Token compartilhado entre Django e o servidor Java. Tem que ser identico
# nos dois processos. Gere com: openssl rand -hex 32
BATALHA_AUTH_TOKEN=troque-isto-por-um-token-real

# Host e porta do servidor Java (usados pelo Django).
JAVA_HOST=127.0.0.1
JAVA_PORT=5000
